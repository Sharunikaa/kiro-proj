{
  "name": "orchestrator",
  "description": "Project Manager and pipeline orchestrator for the AI Software Engineering Team. The only agent allowed to spawn sub-agents; drives the lifecycle with human approval gates.",
  "prompt": "file:///Users/sharunikaass/Documents/kiro-proj/.kiro/agents/prompts/orchestrator.md",
  "tools": [
    "read",
    "write",
    "shell",
    "subagent",
    "@git"
  ],
  "allowedTools": [
    "read",
    "@git/git_status",
    "@git/git_log",
    "@git/git_diff",
    "@git/git_diff_staged",
    "@git/git_diff_unstaged",
    "@git/git_show"
  ],
  "mcpServers": {
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "/Users/sharunikaass/Documents/kiro-proj"
      ],
      "timeout": 120000,
      "disabledTools": [
        "git_create_branch",
        "git_checkout",
        "git_reset",
        "git_init",
        "git_branch"
      ]
    }
  },
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "projects/**"
      ]
    },
    "shell": {
      "allowedCommands": [
        "scripts/new-project.sh.*",
        "mkdir .*",
        "cat .*",
        "ls .*"
      ],
      "autoAllowReadonly": true
    },
    "crew": {
      "availableAgents": [
        "requirements-analyst",
        "software-architect",
        "developer",
        "tester",
        "security-reviewer",
        "documentation-agent"
      ],
      "trustedAgents": [
        "requirements-analyst",
        "software-architect",
        "developer",
        "tester",
        "security-reviewer",
        "documentation-agent"
      ]
    }
  },
  "resources": [
    "file://.kiro/steering/**/*.md",
    "file://spec.md",
    "file://projects/**/status.json"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "python --version 2>&1; pytest --version 2>&1 || echo 'pytest not installed'; uvx --version 2>&1 || echo 'uvx MISSING (Git MCP will not start)'; git -C /Users/sharunikaass/Documents/kiro-proj rev-parse --is-inside-work-tree >/dev/null 2>&1 && echo 'git repo: OK' || echo 'git repo: MISSING'"
      }
    ],
    "stop": [
      {
        "command": ".kiro/hooks/update-status.sh"
      }
    ]
  },
  "keyboardShortcut": "ctrl+shift+o",
  "welcomeMessage": "AI Software Engineering Team orchestrator ready. Give me a project idea to begin."
}
