{
  "name": "documentation-agent",
  "description": "Produces README and project documentation from the upstream artifacts. Writes README.md and docs/.",
  "prompt": "file:///Users/sharunikaass/Documents/kiro-proj/.kiro/agents/prompts/documentation-agent.md",
  "tools": [
    "read",
    "write"
  ],
  "allowedTools": [
    "read"
  ],
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "projects/**/README.md",
        "projects/**/docs/**"
      ],
      "deniedPaths": [
        "projects/**/src/**",
        "projects/**/tests/**"
      ]
    }
  },
  "resources": [
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/documentation/SKILL.md"
  ],
  "hooks": {
    "postToolUse": [
      {
        "matcher": "write",
        "command": ".kiro/hooks/validate-artifacts.sh"
      }
    ],
    "stop": [
      {
        "command": ".kiro/hooks/update-status.sh"
      }
    ]
  }
}
